{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/kernel/src/**/*.ts",
    "../../packages/db/src/**/*.ts",
    "../../extensions/sample-ts/src/**/*.ts"
  ]
}
