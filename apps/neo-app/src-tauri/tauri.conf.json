{
  "productName": "Neo Meta Harness",
  "version": "1.0.1",
  "identifier": "com.neometaharness.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node ../../scripts/installer-check.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "neo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQkREOTk0RERBMzVBRjYKUldUMldxUGRsTm05OEI2NU1pZWpxSm1ibTJvQnNtN2dKZi93VjY4ZlNNcFZpL0NsWUNEUVovVGwK",
      "endpoints": [
        "https://github.com/NeoMetaHarness/NeoMetaHarness/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "allowedHosts": [
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
