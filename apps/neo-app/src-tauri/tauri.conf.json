{
  "productName": "Neo Meta Harness",
  "version": "0.1.0",
  "identifier": "com.neometaharness.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build && pnpm --config.strict-dep-builds=false --config.verifyDepsBeforeRun=false --dir ../.. installer:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["neo"] }
    },
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "externalBin": ["binaries/neo-gateway"],
    "resources": { "installer-payload/": "gateway/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_BASE64_MINISIGN_PUBLIC_KEY",
      "endpoints": ["https://github.com/NeoMetaHarness/NeoMetaHarness/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
