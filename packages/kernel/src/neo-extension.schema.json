{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "version", "displayName", "runtime"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "version": { "type": "string" },
    "publisher": { "type": "string" },
    "displayName": { "type": "string", "minLength": 1 },
    "neo": { "type": "string" },
    "kind": { "type": "array", "items": { "type": "string" } },
    "dependsOn": { "type": "object", "additionalProperties": { "type": "string" } },
    "runtime": {
      "oneOf": [
        { "type": "object", "required": ["type", "entry"], "properties": { "type": { "const": "cordis" }, "entry": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "command", "protocol"], "properties": { "type": { "const": "process" }, "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "protocol": { "enum": ["jsonrpc", "jsonrpc+mcp"] } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["ui-only", "content"] } }, "additionalProperties": false }
      ]
    },
    "contributes": { "type": "object" },
    "projections": { "type": "object" },
    "permissions": { "type": "object" },
    "activation": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
