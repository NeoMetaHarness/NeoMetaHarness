{
  "name": "neometaharness",
  "private": true,
  "type": "module",
  "description": "Neo Meta Harness: one always-on super agent, any computer, any channel, any model. Everything is an extension.",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test:p3-4": "pnpm --dir apps/neo-app build && pnpm --dir extensions/computer-vnc typecheck && pnpm --dir extensions/computer-vnc test && pnpm --dir apps/gateway exec tsx ../../apps/neo-app/test/p3-4.mjs",
    "deploy:check": "node scripts/deploy-check.mjs && node --test scripts/test/deploy.test.mjs",
    "neo:backup": "pnpm --dir apps/gateway exec tsx src/backup-cli.ts",
    "neo:restore": "pnpm --dir apps/gateway exec tsx src/restore-cli.ts",
    "check": "node scripts/check.mjs",
    "upstream:check": "node scripts/upstream.mjs",
    "org:scaffold": "node scripts/org/scaffold.mjs",
    "test:toggle": "node tests/toggle-safety/run.mjs",
    "test:p1": "pnpm --dir apps/gateway test:p1",
    "test:p1-2": "pnpm --dir apps/neo-app test:p1-2",
    "test:p1-5": "pnpm --dir apps/neo-app test:p1-5",
    "test:p4-7": "pnpm --dir apps/neo-app test:p4-7"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "yaml": "^2.8.1"
  }
}


