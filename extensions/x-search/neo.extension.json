{
  "id": "x-search",
  "version": "0.1.0",
  "displayName": "xAI X Search",
  "kind": ["tool"],
  "runtime": { "type": "cordis", "entry": "./src/index.ts" },
  "settings": {
    "type": "object",
    "properties": {
      "apiKey": { "type": "string", "title": "xAI API key", "secret": true },
      "baseUrl": { "type": "string", "title": "xAI API origin", "default": "https://api.x.ai" },
      "model": { "type": "string", "title": "Search model", "default": "grok-4.7" },
      "allowPrivateNetwork": { "type": "boolean", "title": "Allow private-network endpoints (admin only)", "default": false },
      "requestsPerMinutePerUser": { "type": "integer", "title": "Requests per minute per user", "minimum": 1, "maximum": 60, "default": 5 },
      "requestsPerMinutePerWorkspace": { "type": "integer", "title": "Requests per minute per workspace", "minimum": 1, "maximum": 600, "default": 20 },
      "requestsPerDayPerUser": { "type": "integer", "title": "Requests per day per user", "minimum": 1, "maximum": 10000, "default": 100 },
      "requestsPerDayPerWorkspace": { "type": "integer", "title": "Requests per day per workspace", "minimum": 1, "maximum": 100000, "default": 500 }
    }
  }
}
