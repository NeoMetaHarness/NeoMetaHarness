{
  "id": "sample-ts",
  "version": "0.1.0",
  "displayName": "TypeScript sample",
  "kind": [
    "feature"
  ],
  "runtime": {
    "type": "cordis",
    "entry": "./src/index.ts"
  },
  "settings": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "title": "Greeting Message",
        "description": "Greeting message returned by hello route",
        "default": "Hello from TypeScript"
      },
      "maxRetries": {
        "type": "number",
        "title": "Max Retries",
        "description": "Maximum number of retry attempts",
        "default": 3,
        "minimum": 1,
        "maximum": 10
      },
      "apiSecret": {
        "type": "string",
        "title": "API Secret",
        "description": "Secret API token stored in vault",
        "secret": true
      }
    }
  }
}
