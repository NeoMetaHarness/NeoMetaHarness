{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Panda Model Router",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint",
    "roles"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "format": "uri",
      "description": "HTTP(S) Panda base URL. No credentials or query parameters."
    },
    "vaultSecret": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "description": "Existing credential in workspace default vault; never the key itself."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 10000,
      "default": 1500
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "providerId",
              "model"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "providerId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fast": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "providerId",
              "model"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "providerId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reasoning": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "providerId",
              "model"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "providerId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "coding": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "providerId",
              "model"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "providerId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "eval": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelId",
              "providerId",
              "model"
            ],
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "providerId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
