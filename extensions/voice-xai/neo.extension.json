{
  "id": "voice-xai",
  "version": "0.1.0",
  "displayName": "xAI Voice",
  "kind": ["tool"],
  "runtime": { "type": "cordis", "entry": "./src/index.ts" },
  "settings": {
    "type": "object",
    "properties": {
      "apiKey": { "type": "string", "title": "xAI API key", "secret": true },
      "baseUrl": { "type": "string", "title": "xAI API origin", "default": "https://api.x.ai" },
      "allowPrivateNetwork": { "type": "boolean", "title": "Allow private-network xAI origin", "default": false },
      "requestsPerMinute": { "type": "integer", "title": "Voice requests per user per minute", "default": 12, "minimum": 1, "maximum": 120 }
    }
  }
}
